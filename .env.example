# Copy to .env and fill in. .env is gitignored; never commit it.
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Model slugs from https://openrouter.ai/models
# Strong model: briefing generation + claim verification
LLM_MODEL=anthropic/claude-sonnet-5.5
# Fast/cheap model: entity-link tie-breaks, commitment extraction, eval judge
LLM_MODEL_FAST=anthropic/claude-haiku-5.5
